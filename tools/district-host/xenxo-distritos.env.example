# /etc/xenxo-distritos.env — configuración del servidor de distritos (permisos 640, root:xenxo).
# Clave PÚBLICA (JWK de una línea) que enseña `node tools/district-host/keys.mjs`. No es secreta.
DISTRICT_PUBLIC_KEY={"kty":"OKP","crv":"Ed25519","x":"..."}
# Chunks que atiende este servidor (los distritos). Deben coincidir con REMOTE_CHUNKS del Worker.
HOSTED_CHUNKS=c_1_0,c_-1_0,c_0_1,c_0_-1,c_1_-1,c_-1_-1,c_-1_1
# Worker de Cloudflare: de ahí se piden las medidas de los modelos de la gente.
ASSETS_URL=https://api.xenxo.io
