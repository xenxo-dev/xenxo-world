# /etc/xenxo-backup.env  (chmod 600). No lo subas a ningún repositorio.
XENXO_URL=https://api.xenxo.io
# La clave de copias (permiso «backup»): la que generaste, no su huella.
XENXO_BACKUP_KEY=
# La frase con la que se cifra la copia. Guárdala también fuera de este equipo: sin ella no se puede leer.
XENXO_BACKUP_PASSPHRASE=
# Dónde se guardan (por ejemplo, la carpeta del NAS montada).
XENXO_BACKUP_DIR=/mnt/nas/xenxo/copias
XENXO_BACKUP_KEEP=30
