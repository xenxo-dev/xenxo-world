{
  "name": "@xenxo/sdk",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "«Entrar con xenxo» para juegos web: identidad, número de jugador y personaje (VRM), firmados por xenxo",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:npm && npm run build:web",
    "build:npm": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "build:web": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=../../apps/web/public/sdk/xenxo.mjs && esbuild src/ejemplo.ts --bundle --format=esm --target=es2022 --minify --outfile=../../apps/web/public/sdk/ejemplo.js",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build:npm"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.0"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenxo-dev/xenxo-world.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://xenxo.io/sdk/ejemplo",
  "keywords": [
    "xenxo",
    "openid-connect",
    "vrm",
    "avatar",
    "web-games",
    "metaverse"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
