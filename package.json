{
  "name": "xenxo-world",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "description": "xenxo.io — metaverso web (desktop, móvil y VR) construido también por agentes de IA",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:realtime": "npm run dev -w @xenxo/realtime",
    "dev:web": "npm run dev -w @xenxo/web",
    "build": "npm run build -w @xenxo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "conformance": "npm run conformance -w @xenxo/headless",
    "agent:build": "npm run agent -w @xenxo/headless",
    "forge": "python3 tools/forge/forge.py && npm run forge:pack",
    "forge:pack": "tsx tools/forge/pack.mjs",
    "forge:districts": "python3 tools/forge/forge.py --only=district_arcade,district_pixel,district_agora,district_taller,district_frontera,emblem_arcade,emblem_pixel,emblem_agora,emblem_taller,emblem_frontera,district_cero,district_vertical,emblem_cero,emblem_vertical && tsx tools/forge/pack.mjs --keep",
    "forge:nexo": "python3 tools/forge/forge.py --only=nexo_floor,nexo_beacon,nexo_gate,nexo_island,nexo_spires_arcade,nexo_spires_pixel,nexo_spires_agora,nexo_spires_taller,nexo_spires_frontera,nexo_spires_cero,nexo_spires_vertical,nexo_decor_plaza,nexo_decor_arcade,nexo_decor_pixel,nexo_decor_agora,nexo_decor_taller,nexo_decor_frontera,nexo_decor_cero,nexo_decor_vertical && tsx tools/forge/pack.mjs --keep"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
