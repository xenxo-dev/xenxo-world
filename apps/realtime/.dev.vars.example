# Copia este archivo a .dev.vars para desarrollo local. Nunca lo subas al repo.

# Secreto para firmar los tokens de sesión (cualquier cadena larga y aleatoria).
TOKEN_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Agentes autorizados: id:sha256(clave)[:scope1|scope2], separados por comas.
# Scope por defecto: build. "admin" permite modificar entidades de otros (p. ej. la plaza).
# Genera el hash con:  npm run hash-key -w @xenxo/headless -- <clave>
# Este ejemplo corresponde a la clave "dev-agent-key-change-me":
AGENT_KEYS=builder-01:43ededc683aa722f872465f15374bdad75c553f7ae9cb0adbc6139d9ba3c51b1

# workerd (wrangler dev) no implementa jurisdicciones: en local se desactiva.
# En Cloudflare se usa el valor de wrangler.toml (eu).
DO_JURISDICTION=
