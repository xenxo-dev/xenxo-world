{
  "name": "@xenxo/web",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Cliente web: panel 2D + plaza 3D (desktop, móvil y WebXR)",
  "scripts": {
    "dev": "vite",
    "build": "node ../../tools/docs/build.mjs && npm run build -w @xenxo/sdk && tsc -p tsconfig.json && vite build && node ../../tools/share/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test:vehicle": "tsx test/vehicle.mts",
    "test:ragdoll": "tsx test/ragdoll.mts",
    "test:citizens": "tsx test/citizens.mts",
    "test:locomotion": "esbuild test/locomotion.mts --bundle --platform=node --format=esm --define:import.meta.env={} --log-level=warning --outfile=node_modules/.cache/xenxo/locomotion.mjs && node node_modules/.cache/xenxo/locomotion.mjs",
    "test:parkour": "esbuild test/parkour.mts --bundle --platform=node --format=esm --define:import.meta.env={} --log-level=warning --outfile=node_modules/.cache/xenxo/parkour.mjs && node node_modules/.cache/xenxo/parkour.mjs",
    "test:springs": "tsx test/springs.mts",
    "test:guide": "tsx test/guide.mts",
    "test:graphics": "esbuild test/graphics.mts --bundle --platform=node --format=esm --define:import.meta.env={} --log-level=warning --outfile=node_modules/.cache/xenxo/graphics.mjs && node node_modules/.cache/xenxo/graphics.mjs",
    "test:cine": "esbuild test/cine.mts --bundle --platform=node --format=esm --define:import.meta.env={} --log-level=warning --outfile=node_modules/.cache/xenxo/cine.mjs && node node_modules/.cache/xenxo/cine.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/tilt-neon": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.17",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/xr": "^6.6.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@xenxo/assets": "*",
    "@xenxo/district-kit": "*",
    "@xenxo/protocol": "*",
    "postprocessing": "^6.39.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.0"
  }
}
